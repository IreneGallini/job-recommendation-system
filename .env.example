# URL of the SimplifyJobs internship README to watch.
# Update this when the Summer2028 repo is created (usually July/August of the prior year).
# Current default targets Summer2027; swap to Summer2028-Internships when available.
SIMPLIFY_README_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/README.md

# Optional: Adzuna job-aggregator API (free key: developer.adzuna.com).
# Runs once a day on its own; set ADZUNA_FORCE=1 to run it on a local run.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_FORCE=1

# Optional overrides for local testing
# CSV_PATH=internships.csv
# README_PATH=README.md
# COMPANIES_YAML_PATH=companies.yaml
